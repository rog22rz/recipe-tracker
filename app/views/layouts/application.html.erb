<!DOCTYPE html>
<html>
  <head>
    <title>Ken's Favorite Recipes</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/buttons", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/cards", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/forms", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/modal", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "recipes", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body">
    <header class="app-header">
      <div class="container header-inner">
        <h1 class="logo">
          <%= link_to "🍲 Kennedy's Favorite Recipes", root_path %>
        </h1>
        <nav class="nav-links">
          <%= link_to "All Recipes", recipes_path, class: "nav-link" %>
          <%= link_to "New Recipe", new_recipe_path, class: "nav-link" %>
        </nav>
      </div>
    </header>

    <main class="app-main">
      <div class="container">
        <% if notice %>
          <p class="flash flash-notice"><%= notice %></p>
        <% end %>

        <%= yield %>
      </div>
    </main>

    <footer class="app-footer">
      <div class="container">
        <p>&copy; <%= Time.current.year %> My Recipe Book</p>
      </div>
    </footer>
  </body>
</html>

