<h2 class="page-title">Recipes</h2>

<% if @tags.any? %>
  <div class="tag-filter">
    <%= link_to "All", recipes_path, class: "tag-pill #{@current_tag.nil? ? 'tag-pill-active' : ''}" %>
    <% @tags.each do |tag| %>
      <%= link_to tag.name.capitalize, recipes_path(tag: tag.name), class: "tag-pill #{@current_tag == tag.name ? 'tag-pill-active' : ''}" %>
    <% end %>
  </div>
<% end %>

<% if @recipes.any? %>
  <ul class="recipe-list">
    <% @recipes.each do |recipe| %>
      <li>
        <%= link_to recipe_path(recipe), class: "card recipe-card-link" do %>
          <h3 class="card-title"><%= recipe.title %></h3>

          <% if recipe.tags.any? %>
            <div class="recipe-tags">
              <% recipe.tags.each do |tag| %>
                <span class="tag-badge"><%= tag.name %></span>
              <% end %>
            </div>
          <% end %>

          <% ingredients = recipe.ingredients.to_s.split("\n").reject(&:blank?) %>
          <% if ingredients.any? %>
            <p class="card-meta">
              <%= pluralize(ingredients.size, "ingredient") %>
            </p>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <div class="card-actions" style="margin-bottom: 0.75rem;">
    <%= link_to "➕ New Recipe", new_recipe_path, class: "btn btn-primary" %>
  </div>
<% else %>
  <% if @current_tag %>
    <p>No recipes with tag "<%= @current_tag %>". <%= link_to "View all recipes", recipes_path %>.</p>
  <% else %>
    <p>No recipes yet. Why not add your first one? 🧑‍🍳</p>
    <%= link_to "Create a Recipe", new_recipe_path, class: "btn btn-primary" %>
  <% end %>
<% end %>

