<div class="form-card">
  <%= form_with model: @recipe, local: true do |form| %>
    <% if @recipe.errors.any? %>
      <div class="flash" style="background:#fed7d7;color:#742a2a;">
        <strong><%= pluralize(@recipe.errors.count, "error") %> prevented this recipe from being saved:</strong>
        <ul>
          <% @recipe.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :title, class: "form-label" %>
      <%= form.text_field :title, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :ingredients, "Ingredients (one per line)", class: "form-label" %>
      <%= form.text_area :ingredients, rows: 5, class: "form-textarea", placeholder: "1 cup flour\n2 eggs\n1 tbsp sugar" %>
    </div>

    <div class="form-group">
      <%= form.label :instructions, class: "form-label" %>
      <%= form.textarea :instructions, rows: 8, class: "form-textarea" %>
    </div>

    <div class="form-group">
      <%= form.label :tag_list, "Tags (comma separated)", class: "form-label" %>
      <%= text_field_tag :tag_list, @recipe.tags.pluck(:name).join(", "), class: "form-input", placeholder: "dinner, korean, easy" %>
      <p class="form-hint">Add tags like: dinner, lunch, dessert, korean, easy, quick</p>
    </div>

    <div class="card-actions">
      <%= form.submit class: "btn btn-primary" %>
      <%= link_to "Cancel", recipes_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>

